ATLAS_WORKSPACE_ROOT=.
ATLAS_DATA_DIR=.atlas
ATLAS_LOG_LEVEL=INFO
ATLAS_JSON_LOGS=false
ATLAS_MODEL_TIMEOUT_SECONDS=120
ATLAS_OPERATION_TIMEOUT_SECONDS=1800
ATLAS_MAX_TOOL_OUTPUT_BYTES=131072
ATLAS_MAX_READ_BYTES=1048576
ATLAS_APPROVAL_MODE=on_request
ATLAS_ALLOW_NETWORK=false
ATLAS_MODEL_PROVIDER=openai
ATLAS_MODEL_NAME=gpt-4o-mini
# ATLAS_MODEL_BASE_URL=https://api.openai.com/v1
# ATLAS_MODEL_API_KEY=replace-me
ATLAS_MODEL_MAX_RETRIES=2
ATLAS_MODEL_MAX_OUTPUT_TOKENS=4096
ATLAS_MAX_ITERATIONS=12
ATLAS_MAX_TOOL_CALLS=48
